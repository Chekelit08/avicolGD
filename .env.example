# Copiá este archivo como .env.local y completalo con los datos de tu proyecto Supabase.
# Están en Supabase → Project Settings → API.
#
# Solo va la clave PÚBLICA (anon / publishable). Está pensada para estar en el navegador:
# la seguridad la dan las políticas RLS de la base.
# NUNCA pongas acá la clave service_role / secret: da acceso total y saltea RLS.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica
